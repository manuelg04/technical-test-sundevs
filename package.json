{
  "name": "restaurant-ordering-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Technical test: NestJS ordering API with order timeline viewer.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:worker": "npm --workspace apps/api run start:worker",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm --workspace apps/api run test",
    "test:web": "npm --workspace apps/web run lint",
    "seed:menu": "npm --workspace apps/api run seed:menu"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
